# ============================================
# 开发环境配置模板
# 使用方式：复制本文件为 application-dev.yml，填入真实值后使用
# 该真实文件已在 .gitignore 中忽略，不会提交到仓库
# ============================================

# 开发环境：后端跑在本机 Windows，MySQL 也在本机
spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:3306/userdb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    # 改成你自己的 MySQL 密码
    password: your-mysql-password

mybatis-plus:
  configuration:
    # 开发期打印执行的 SQL，方便排查
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

rental:
  # 图片保存目录（本机开发）
  image-dir: D:/rental/images
  image-url-prefix: /images
  # JWT 密钥（至少 32 字节）
  jwt-secret: rental-secret-key-for-development-only-32bytes
  jwt-expire-days: 7
  # 微信小程序配置
  wechat:
    appid: 你的小程序AppID
    # 微信公众平台 → 开发管理 → 开发设置 → AppSecret
    secret: 你的小程序AppSecret
    # 开发期 mock 模式：true=不调用真实微信接口，code 直接作为 openid；false=真实模式
    mock: true